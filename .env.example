# Supabase (seguro expor no cliente — RLS é quem isola os dados)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense (IDs públicos de veiculação, não secretos)
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=

# Segredos da Edge Function scan-label (NUNCA prefixar com VITE_, nunca ir pro bundle do frontend).
# Configurar via `supabase secrets set`, não aqui:
#   ANTHROPIC_API_KEY=
